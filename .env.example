# Copy to .env for local development: cp .env.example .env

SECRET_KEY=dev-only-change-me

# Gemini API key from https://aistudio.google.com/apikey
# Powers the "Analyze with AI" button on the report form.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# First-run only: creates the one super-admin account. If left blank, one
# is generated and printed to the server log on first start.
SUPER_ADMIN_EMAIL=admin@mvv.local
SUPER_ADMIN_PASSWORD=
