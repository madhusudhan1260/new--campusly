# Copy to .env for local development: cp .env.example .env

SECRET_KEY=dev-only-change-me

# Gemini API key from https://aistudio.google.com/apikey
# Powers the "Analyze with AI" button on the report form.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# First-run only: creates the one super-admin account. If left blank, one
# is generated and printed to the server log on first start.
SUPER_ADMIN_EMAIL=admin@mvv.local
SUPER_ADMIN_PASSWORD=

# First-run only, optional: creates the DOSS office account. Leave DOSS_EMAIL
# blank to skip -- a super_admin can promote an existing student to DOSS
# from /admin/users instead.
DOSS_EMAIL=
DOSS_PASSWORD=

# Real campus health center facts, shown on the Health page. Placeholders on
# purpose -- never invent a real-looking number for something a student
# might call in a genuine emergency.
HEALTH_CENTER_NAME=Campus Health Center
HEALTH_CENTER_PHONE=
HEALTH_CENTER_TIMINGS=
HEALTH_CENTER_LOCATION=

# Where claimed Lost & Found items are physically handed over. Shown to
# students right after they submit a claim.
LOST_FOUND_OFFICE=the DOSS office
